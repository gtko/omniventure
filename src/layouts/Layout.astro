---
import { ClientRouter } from 'astro:transitions';
import PageModal from '../components/PageModal.astro';
import Sidebar from '../components/Sidebar.astro';
import { VirtualOffice2D } from '../components/VirtualOffice2D';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  /** Page pleine hauteur sans modale : c'est le bureau lui-même. */
  fullBleed?: boolean;
  /**
   * Masque le bureau derrière la page. La simulation continue de tourner —
   * seul l'affichage est coupé — pour les écrans de travail où la carte
   * distrait plus qu'elle n'aide.
   */
  hideOffice?: boolean;
  /** Sous-titre affiché dans l'en-tête de la modale. */
  subtitle?: string;
  icon?: string;
}

const {
  title,
  description = "OmniVenture AI - Autonomous Money Factory on Cloudflare",
  currentPath = '/',
  fullBleed = false,
  hideOffice = false,
  subtitle,
  icon
} = Astro.props;
---

<!doctype html>
<html lang="fr" class="bg-slate-950 text-slate-900 h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} — OmniVenture AI</title>
    <meta name="description" content={description} />

    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Navigation sans rechargement : indispensable pour garder le bureau vivant. -->
    <ClientRouter />
  </head>
  <body
    class:list={[
      'office-immersive h-full bg-slate-950 text-slate-900 font-sans antialiased overflow-hidden',
      hideOffice && 'office-backdrop-hidden'
    ]}
  >

    <!--
      LE BUREAU EST LE DÉCOR PERMANENT DE L'APPLICATION.
      `transition:persist` conserve le canvas et sa simulation d'une page à
      l'autre : les agents continuent leur journée pendant qu'on travaille
      dans une modale.
    -->
    <div id="office-backdrop" class="fixed inset-0 z-0">
      <VirtualOffice2D
        initialMissionName="Agence OmniVenture — orchestration multi-agents"
        height="100%"
        client:load
        transition:persist="office"
      />
    </div>

    <Sidebar currentPath={currentPath} />

    {fullBleed ? (
      <slot />
    ) : (
      <PageModal title={title} subtitle={subtitle} icon={icon}>
        <slot />
      </PageModal>
    )}

  </body>
</html>
