---
import { ClientRouter } from 'astro:transitions';
import { FloatingMonitor } from '../components/FloatingMonitor';
import PageModal from '../components/PageModal.astro';
import Sidebar from '../components/Sidebar.astro';
import { VirtualOffice2D } from '../components/VirtualOffice2D';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  /** Page pleine hauteur sans modale : c'est le bureau lui-même. */
  fullBleed?: boolean;
  /**
   * Retire le bureau de la page. Le canvas n'est pas seulement masqué : il
   * n'est pas monté du tout, donc la boucle d'animation ne tourne plus et ne
   * dispute plus le processeur aux écrans de travail (analyse concurrentielle).
   * L'état de la simulation est sauvegardé au démontage et repris à la
   * navigation suivante — rien n'est perdu.
   */
  hideOffice?: boolean;
  /** Sous-titre affiché dans l'en-tête de la modale. */
  subtitle?: string;
  icon?: string;
}

const {
  title,
  description = "OmniVenture AI - Autonomous Money Factory on Cloudflare",
  currentPath = '/',
  fullBleed = false,
  hideOffice = false,
  subtitle,
  icon
} = Astro.props;
---

<!doctype html>
<html lang="fr" class="bg-slate-950 text-slate-900 h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} — OmniVenture AI</title>
    <meta name="description" content={description} />

    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Navigation sans rechargement : indispensable pour garder le bureau vivant. -->
    <ClientRouter />
  </head>
  <body class="office-immersive h-full bg-slate-950 text-slate-900 font-sans antialiased overflow-hidden">

    <!--
      LE BUREAU EST LE DÉCOR PERMANENT DE L'APPLICATION.
      `transition:persist` conserve le canvas et sa simulation d'une page à
      l'autre : les agents continuent leur journée pendant qu'on travaille
      dans une modale.

      Sauf sur les écrans qui demandent `hideOffice` : là le bureau est
      réellement absent du document, pas juste transparent.
    -->
    {!hideOffice && (
      <div id="office-backdrop" class="fixed inset-0 z-0">
        <VirtualOffice2D
          initialMissionName="Agence OmniVenture — orchestration multi-agents"
          height="100%"
          client:load
          transition:persist="office"
        />
      </div>
    )}

    <Sidebar currentPath={currentPath} />

    {fullBleed ? (
      <slot />
    ) : (
      <PageModal title={title} subtitle={subtitle} icon={icon}>
        <slot />
      </PageModal>
    )}

    <!--
      Supervision : présente sur toutes les pages, donc montée dans la mise en
      page. `transition:persist` lui évite de repartir de zéro (position,
      compteur de dix secondes) à chaque navigation.
    -->
    <FloatingMonitor client:idle transition:persist="monitor" />

  </body>
</html>
