---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { label: 'Vue d\'ensemble', href: '/' },
  { label: 'Mes Ventures', href: '/ventures' },
  { label: 'Graphe d\'Agents', href: '/agents' },
  { label: 'DevOps & Canary', href: '/canary' },
  { label: 'A/B Testing', href: '/cro' },
  { label: 'Vidéos & Média', href: '/media' },
  { label: 'Comptes Stripe', href: '/monetization' },
];
---

<header class="bg-white border-b border-slate-200 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Brand Logo -->
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-black text-base shadow-sm">
            Ω
          </div>
          <div>
            <span class="font-bold text-base text-slate-900 tracking-tight">OmniVenture</span>
            <span class="text-xs font-semibold px-1.5 py-0.5 rounded bg-indigo-50 text-indigo-700 border border-indigo-100 ml-1.5">Cloudflare</span>
          </div>
        </a>
      </div>

      <!-- Navigation Links -->
      <nav class="hidden md:flex items-center space-x-1">
        {navItems.map((item) => {
          const isActive = currentPath === item.href;
          return (
            <a
              href={item.href}
              class={`px-3 py-2 rounded-lg text-sm transition-colors ${
                isActive
                  ? 'bg-indigo-50 text-indigo-700 font-semibold'
                  : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Right Actions -->
      <div class="flex items-center gap-3">
        <div class="hidden sm:flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-medium">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Edge Workers: 100% OK</span>
        </div>

        <button 
          onclick="window.dispatchEvent(new CustomEvent('open-factory-wizard'))"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold shadow-sm transition-colors"
        >
          <span>+</span>
          <span>Nouveau Business</span>
        </button>
      </div>

    </div>
  </div>
</header>
