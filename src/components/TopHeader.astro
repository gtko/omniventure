---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const pathMap: Record<string, string> = {
  '/': 'Vue d\'ensemble & Paramètres du Projet',
  '/market': 'Analyse Concurrentielle & Marché',
  '/agents': 'Graphe d\'Agents & Contrôle OpenRouter',
  '/marketing': 'Acquisition & Machine Marketing 360°',
  '/media': 'Studio Vidéo TikTok & Média 9:16',
  '/cro': 'A/B Testing Continu & Optimisation',
  '/canary': 'DevOps & Déploiement Canary',
  '/monetization': 'Comptes Stripe & Webhooks',
  '/ventures': 'Tous mes Business'
};

const currentLabel = pathMap[currentPath] || 'Tableau de Bord';
---

<header class="bg-white border-b border-slate-200 sticky top-0 z-20 h-16 flex items-center justify-between px-6">
  <!-- Left: Page Title / Breadcrumb -->
  <div class="flex items-center gap-2 text-xs">
    <span class="text-slate-400">OmniVenture</span>
    <span class="text-slate-300">/</span>
    <span class="font-semibold text-slate-800 text-sm">{currentLabel}</span>
  </div>

  <!-- Right: Minimalist Status -->
  <div class="flex items-center gap-2 text-xs text-slate-500">
    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
    <span class="font-mono text-[11px] text-slate-600">Cloudflare Edge Connected</span>
  </div>
</header>
