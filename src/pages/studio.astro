---
import Layout from '../layouts/Layout.astro';
import { StudioShell } from '../components/studio/StudioShell';
---

<!--
  Les ateliers sont des écrans de travail : aperçus, tableaux, éditeurs. Le
  bureau n'est pas monté ici, la page occupe toute la surface.
-->
<Layout title="Ateliers — Graphisme, Design System, Composants" currentPath="/studio" fullBleed hideOffice>
  <main data-page-surface class="fixed inset-0 z-40 overflow-y-auto bg-slate-100 lg:pl-64">
    <div class="mx-auto max-w-[1500px] px-4 py-6 sm:px-8">
      <StudioShell client:load />
    </div>
  </main>
</Layout>
