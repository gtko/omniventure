---
import Layout from '../layouts/Layout.astro';
import { VirtualOffice2D } from '../components/VirtualOffice2D';
---

<Layout title="Bureau Virtuel — Agence OmniVenture" currentPath="/office" fullBleed>
  <!-- Le bureau EST l'interface : le tableau de bord se superpose en transparence. -->
  <div class="h-full w-full">
    <VirtualOffice2D
      initialMissionName="Agence OmniVenture — orchestration multi-agents"
      autoPlay={true}
      height="100%"
      client:load
    />
  </div>
</Layout>
