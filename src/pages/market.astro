---
import Layout from '../layouts/Layout.astro';
import { MarketRadarStudio } from '../components/MarketRadarStudio';
---

<!--
  L'atelier d'analyse est un écran de travail : rapport long, tableaux, lecture
  suivie. Le bureau n'est pas monté ici (`hideOffice`) et la page occupe toute
  la surface au lieu de tenir dans une modale.
-->
<Layout
  title="Analyse Concurrentielle & Marché"
  currentPath="/market"
  fullBleed
  hideOffice
>
  <main
    data-page-surface
    class="fixed inset-0 z-40 overflow-y-auto bg-slate-100 lg:pl-64"
  >
    <div class="mx-auto max-w-[1500px] px-4 py-6 sm:px-8">
      <MarketRadarStudio client:load />
    </div>
  </main>
</Layout>
